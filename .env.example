# Arrival Time Check Agent — setup values
#
# Claude Code does NOT load this file. The agent reads the values that
# you write into the two markdown files under `.claude/` (see the
# "Customising" table in the README). The names below match those
# placeholders one to one.
#
# Use a copy of this file (`.env`) as the record of your setup, and as
# the place for any credentials that your own PMS / email scripts need.
# Never commit your real `.env` to git.

# ============================================================
# Hotel identity
# ============================================================
# Used in the email sign-off.

HOTEL_NAME="Your Hotel Name"
OPERATOR_NAME="Your Name"

# ============================================================
# Inboxes the drafts are created in
# ============================================================
# The agent NEVER sends — it only creates drafts.

INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email command
# ============================================================
# Command-line wrapper that can create a draft (not included).

EMAIL_CLI="gws gmail"

# ============================================================
# PMS (Property Management System) scripts
# ============================================================
# Your own scripts (not included): one lists upcoming reservations
# with their arrival-time fields, one (optional) appends a note.

PMS_LOOKUP_TOOL="tools/check_arrival_times.py"
PMS_NOTES_TOOL="tools/pms_notes.py"
