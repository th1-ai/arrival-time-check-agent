# Arrival Time Check Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Hotel identity
# ============================================================
# Used in email signatures and to set tone in drafts.

HOTEL_NAME="Your Hotel Name"
OPERATOR_NAME="Your Name"

# ============================================================
# Email accounts the agent will draft from
# ============================================================
# The agent NEVER sends — it only creates drafts in the
# selected outbound account.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# Command-line wrapper used to create Gmail drafts.
# Reference setup uses Google Workspace CLI (`gws`).

EMAIL_CLI="gws gmail"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# Tools the agent uses to look up upcoming reservations and
# (optionally) append a note once a draft is created.

PMS_LOOKUP_TOOL="tools/check_arrival_times.py"
PMS_NOTES_TOOL="tools/pms_notes.py"

# Default look-ahead window when scanning for missing ETAs
ARRIVAL_LOOKAHEAD_DAYS="7"
